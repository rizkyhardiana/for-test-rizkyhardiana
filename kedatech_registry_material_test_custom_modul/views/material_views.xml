<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_material_registry_form" model="ir.ui.view">
        <field name="name">material.registry.form</field>
        <field name="model">material.registry</field>
        <field name="arch" type="xml">
            <form string="Material">
                <sheet>
                    <div class="oe_title">
                        <label class="oe_edit_only" for="name" string="Material Name"/>
                        <h1>
                            <field name="name" placeholder="Material Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="type"/>
                        </group>
                        <group>
                            <field name="buy_price" widget='monetary'
                                   options="{'currency_field': 'currency_id'}"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="supplier_id"/>
                        </group>
                    </group>
                    <group string="Material Details">
                        <field name="detail_line_ids">
                            <tree editable="bottom">
                                <field name="color"/>
                                <field name="size"/>
                            </tree>
                        </field>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_material_registry_tree" model="ir.ui.view">
        <field name="name">material.registry.tree</field>
        <field name="model">material.registry</field>
        <field name="arch" type="xml">
            <tree string="Materials" default_order="create_date desc">
                <field name="code"/>
                <field name="name"/>
                <field name="type"/>
                <field name="buy_price"/>
                <field name="supplier_id"/>
            </tree>
        </field>
    </record>

    <record id="material_search_view" model="ir.ui.view">
        <field name="name">material.registry.search</field>
        <field name="model">material.registry</field>
        <field name="arch" type="xml">
            <search string="Search Materials">
                <field name="name"/>
                <field name="code"/>
                <separator/>
                <filter name="filter_fabric" string="Fabric" domain="[('type','=','fabric')]"/>
                <filter name="filter_jeans" string="Jeans" domain="[('type','=','jeans')]"/>
                <filter name="filter_cotton" string="Cotton" domain="[('type','=','cotton')]"/>
            </search>
        </field>
    </record>

    <record id="action_material_registry" model="ir.actions.act_window">
        <field name="name">Materials</field>
        <field name="res_model">material.registry</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{}</field>
        <field name="domain">[]</field>
        <field name="search_view_id" ref="material_search_view"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first material
            </p>
        </field>
    </record>

    <menuitem id="menu_material_root" name="Material Management"
              web_icon="kedatech_registry_material_test_custom_modul,static/description/icon.png"
              sequence="10"/>
    <menuitem id="menu_material_registry" name="Materials" parent="menu_material_root"
              action="action_material_registry"/>

</odoo>
